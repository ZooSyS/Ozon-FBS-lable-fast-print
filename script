// ==UserScript==
// @name         Ozon Seller - Безупречная автопечать (Финальный стандарт)
// @namespace    http://tampermonkey.net
// @version      26.0
// @description  Выводит этикетку на печать в 1 клик, не дает окну сохранения всплывать и мгновенно реанимирует кнопку Озона
// @author       AI Assistant
// @match        https://*.ozon.ru/*
// @match        https://ozon.ru*
// @include      /https:\/\/.*seller\.ozon\.ru.*/
// @grant        none
// @run-at       document-start
// ==/UserScript==

(function() {
    'use strict';

    let isOurPrintJob = false;
    let lastClickedButton = null;

    // Скрытый контролируемый фрейм для вызова диалога печати
    function printBlobPdf(blob) {
        try {
            isOurPrintJob = true;
            const blobUrl = URL.createObjectURL(blob);
            isOurPrintJob = false;

            let iframe = document.getElementById('ozon-direct-print-frame');
            if (!iframe) {
                iframe = document.createElement('iframe');
                iframe.id = 'ozon-direct-print-frame';
                iframe.style.position = 'fixed';
                iframe.style.width = '0';
                iframe.style.height = '0';
                iframe.style.border = 'none';
                document.body.appendChild(iframe);
            }

            iframe.src = blobUrl;
            iframe.onload = function() {
                setTimeout(() => {
                    iframe.contentWindow.focus();
                    iframe.contentWindow.print();
                    setTimeout(() => URL.revokeObjectURL(blobUrl), 1000);
                }, 300);
            };
        } catch (e) {
            console.error('Ошибка скрипта печати:', e);
        }
    }

    // Ловим кнопку Озона в момент нажатия, чтобы запомнить её элемент до появления спиннера
    window.addEventListener('click', function(event) {
        const button = event.target.closest('button');
        if (button && (button.innerText.includes('Этикетка') || (button.title && button.title.includes('Формат')))) {
            lastClickedButton = button;
        }
    }, { capture: true, passive: true });

    // --- ИДЕАЛЬНЫЙ СКВОЗНОЙ ПЕРЕХВАТ ОБЪЕКТА ФАЙЛА ---
    const originalCreateObjectURL = URL.createObjectURL;
    URL.createObjectURL = function(obj) {
        if (obj instanceof Blob && obj.type === 'application/pdf') {

            // Если запрос идет НЕ от нашего принтера — отправляем копию файла на печать
            if (!isOurPrintJob) {
                console.log('Скрипт перехватил реальный PDF и отправил на печать.');
                printBlobPdf(obj);
            }

            // ТОЧЕЧНАЯ РЕАНИМАЦИЯ ИНТЕРФЕЙСА (Убираем серое состояние и спиннер)
            // Даем Озону 100 миллисекунд завершить свой фоновый поток,
            // а затем жестко сбрасываем блокировки, которые наложил React
            setTimeout(() => {
                if (lastClickedButton) {
                    console.log('Оживляем заблокированную кнопку Озона...');

                    // Убираем системные атрибуты блокировки
                    lastClickedButton.removeAttribute('disabled');
                    lastClickedButton.style.pointerEvents = 'auto';
                    lastClickedButton.style.opacity = '1';

                    // Если Озон вставил крутящееся колесико спиннера — стираем его из кнопки
                    const spinner = lastClickedButton.querySelector('svg, [class*="spinner"], [class*="loading"]');
                    if (spinner) {
                        spinner.remove();
                    }

                    // Если Озон стер или скрыл текст кнопки, принудительно возвращаем его назад
                    if (!lastClickedButton.innerText.includes('Этикетка')) {
                        const textSpan = lastClickedButton.querySelector('span');
                        if (textSpan) {
                            textSpan.innerText = 'Этикетка и штрихкод';
                        }
                    }
                }
            }, 100);

            // Отдаем Озону его РОДНОЙ, неповрежденный URL-адрес.
            // Благодаря этому его внутренний код не выдает ошибок,
            // а браузер тихо сохраняет файл в Загрузки в фоновом режиме, не открывая окон.
            return originalCreateObjectURL.apply(this, arguments);
        }
        return originalCreateObjectURL.apply(this, arguments);
    };

})();