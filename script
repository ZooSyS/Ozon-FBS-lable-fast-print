// ==UserScript==
// @name         Ozon Seller — печать этикеток FBS
// @namespace    http://tampermonkey.net
// @version      27.0
// @description  Открывает диалог печати при создании PDF этикетки; штатную загрузку Ozon не отменяет
// @author       AI Assistant
// @match        https://*.ozon.ru/*
// @match        https://ozon.ru*
// @include      /https:\/\/.*seller\.ozon\.ru.*/
// @grant        none
// @run-at       document-start
// ==/UserScript==

(function () {
    'use strict';

    let lastClickedButton = null;
    const originalCreateObjectURL = URL.createObjectURL;

    /**
     * Загружает копию PDF в скрытый iframe и открывает системный диалог печати.
     * Исходную обработку PDF на стороне Ozon скрипт не отменяет.
     */
    function printBlobPdf(blob) {
        let blobUrl;

        try {
            // Используем оригинальный метод: создание URL для iframe не вызывает наш перехват.
            blobUrl = originalCreateObjectURL.call(URL, blob);

            let iframe = document.getElementById('ozon-direct-print-frame');

            if (!iframe) {
                iframe = document.createElement('iframe');
                iframe.id = 'ozon-direct-print-frame';
                iframe.style.position = 'fixed';
                iframe.style.width = '0';
                iframe.style.height = '0';
                iframe.style.border = 'none';
                document.body.appendChild(iframe);
            }

            iframe.onload = function () {
                setTimeout(function () {
                    try {
                        iframe.contentWindow.focus();
                        iframe.contentWindow.print();
                    } catch (error) {
                        console.error('Ошибка вызова диалога печати:', error);
                    } finally {
                        // Сохраняем исходную задержку освобождения URL.
                        setTimeout(function () {
                            URL.revokeObjectURL(blobUrl);
                        }, 1000);
                    }
                }, 300);
            };

            iframe.src = blobUrl;
        } catch (error) {
            console.error('Ошибка скрипта печати:', error);

            // Если URL был создан, но iframe настроить не удалось, освобождаем его.
            if (blobUrl) {
                URL.revokeObjectURL(blobUrl);
            }
        }
    }

    // Запоминаем кнопку этикетки до того, как Ozon изменит её состояние.
    window.addEventListener('click', function (event) {
        const target = event.target;
        const button = target instanceof Element ? target.closest('button') : null;

        if (
            button &&
            (
                button.innerText.includes('Этикетка') ||
                (button.title && button.title.includes('Формат'))
            )
        ) {
            lastClickedButton = button;
        }
    }, { capture: true, passive: true });

    // Перехватываем создание PDF Blob и отправляем его копию в скрытый iframe.
    URL.createObjectURL = function (object) {
        if (object instanceof Blob && object.type === 'application/pdf') {
            console.log('Перехвачен PDF Blob: открываем диалог печати.');
            printBlobPdf(object);

            // Сохраняем исходное поведение Ozon: возвращаем ему штатный Blob URL.
            // Поэтому загрузка и диалог сохранения браузера могут по-прежнему появляться.
            setTimeout(function () {
                if (!lastClickedButton || !lastClickedButton.isConnected) {
                    return;
                }

                console.log('Восстанавливаем доступность кнопки этикетки.');

                // Оставлено намеренно для сохранения текущего поведения скрипта.
                lastClickedButton.removeAttribute('disabled');
                lastClickedButton.style.pointerEvents = 'auto';
                lastClickedButton.style.opacity = '1';

                // Сохраняем существующую логику удаления индикатора загрузки.
                const spinner = lastClickedButton.querySelector(
                    'svg, [class*="spinner"], [class*="loading"]'
                );

                if (spinner) {
                    spinner.remove();
                }

                if (!lastClickedButton.innerText.includes('Этикетка')) {
                    const textSpan = lastClickedButton.querySelector('span');

                    if (textSpan) {
                        textSpan.innerText = 'Этикетка и штрихкод';
                    }
                }
            }, 100);

            return originalCreateObjectURL.apply(this, arguments);
        }

        return originalCreateObjectURL.apply(this, arguments);
    };
})();